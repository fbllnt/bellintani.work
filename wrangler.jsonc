// Cloudflare Workers static site: serves the repository root as plain files (no build, no server code).
{
  "name": "bellintani-work",
  "compatibility_date": "2026-10-01",
  // Tells the page which country the visitor is in (language choice) and answers the Pop quiz. See worker/index.js.
  "main": "worker/index.js",
  // Writes p/<slug>/index.html for every project and the sitemap before each deploy (tools/build-pages.mjs)
  "build": { "command": "node tools/build-pages.mjs && node tools/build-facts.mjs" },
  // Pop quiz answers (worker/index.js, POST /api/ask): Cloudflare Workers AI, no outside key
  "ai": { "binding": "AI" },
  // At most 12 quiz questions a minute per visitor
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }],
  // No public workers.dev address for the site itself; preview links on (drafts are reviewed there before going live)
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "bellintani.work", "custom_domain": true },
    { "pattern": "www.bellintani.work", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // The worker runs for the pages only, not for images, scripts or styles
    "run_worker_first": ["/", "/p/*", "!/p/*/*.*", "/api/*", "/quiz*", "/popquiz*"]
  }
}
